// Enterprise / self-controlled datastore target.
//
// The app runs FREE and self-hosted on the default file-backed repository with no
// database at all. Organizations that want to own their data set
// DATABASE_DRIVER=prisma + DATABASE_URL and implement src/server/prismaRepository.ts
// against this schema (it mirrors src/server/types.ts and the Repository interface).
//
//   npx prisma migrate deploy   # apply migrations
//   npx prisma generate         # generate the client
//
// Switch `provider` to "sqlite" for a single-file DB, or keep "postgresql" for the
// docker-compose stack (app + Postgres + Redis).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id
  handle      String       @unique
  email       String?      @unique
  createdAt   DateTime     @default(now())
  stats       UserStats?
  memberships Membership[]
  events      RoundEvent[]
}

model MagicToken {
  token     String   @id
  email     String
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([email])
}

model Org {
  id                 String       @id
  name               String
  joinCode           String       @unique
  createdAt          DateTime     @default(now())
  leaderboardDisplay String       @default("handle") // real | handle | anonymous
  competitiveEnabled Boolean      @default(true)
  memberships        Membership[]
  events             RoundEvent[]
  audit              AuditEntry[]
}

model Membership {
  userId   String
  orgId    String
  role     String   @default("player") // player | org_admin
  team     String?
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  org      Org      @relation(fields: [orgId], references: [id])

  @@id([userId, orgId])
  @@index([orgId])
}

model UserStats {
  userId          String   @id
  xp              Int      @default(0)
  totalAnswered   Int      @default(0)
  totalCorrect    Int      @default(0)
  falsePositives  Int      @default(0)
  falseNegatives  Int      @default(0)
  bestStreak      Int      @default(0)
  techniqueSeen   Json     @default("{}")
  techniqueCaught Json     @default("{}")
  lastActive      DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
}

model RoundEvent {
  id              String   @id
  userId          String
  orgId           String?
  at              DateTime @default(now())
  difficulty      String
  total           Int
  correct         Int
  points          Int
  falsePositives  Int
  falseNegatives  Int
  techniqueSeen   Json     @default("{}")
  techniqueCaught Json     @default("{}")
  user            User     @relation(fields: [userId], references: [id])
  org             Org?     @relation(fields: [orgId], references: [id])

  @@index([orgId, at])
  @@index([at])
}

model AuditEntry {
  id      String   @id
  orgId   String
  actorId String
  action  String
  detail  String
  at      DateTime @default(now())
  org     Org      @relation(fields: [orgId], references: [id])

  @@index([orgId, at])
}
