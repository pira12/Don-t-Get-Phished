# --- Don't Get Phished backend configuration ---
# Everything here is OPTIONAL. With no .env at all, the app runs the free,
# self-hosted, file-backed backend (data in ./.data/izd-db.json).

# Sign secret for session cookies + magic tokens. CHANGE THIS in production.
AUTH_SECRET=change-me-to-a-long-random-string

# Datastore driver: "json" (default, file-backed, zero-dependency) or "prisma".
# DATABASE_DRIVER=prisma
# DATABASE_URL=postgresql://izd:izd@localhost:5432/izd

# Where the file store writes (json driver only).
# DATA_FILE=./.data/izd-db.json

# Set to 1 once you've wired a real email provider for magic links; until then the
# login code is returned in the API response so the flow is usable in dev/self-host.
# EMAIL_ENABLED=1

# Optional Redis for matchmaking/presence/rate-limiting (Phase 2b, not required).
# REDIS_URL=redis://localhost:6379
